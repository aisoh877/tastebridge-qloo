{
  "name": "tastebridge-demo",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "QLOO_EXPIRES_AT": "2026-10-30T00:00:00Z",
    "QLOO_LIVE_ENABLED": "false",
    "QLOO_STOP": "true",
    "QLOO_TOTAL_REQUEST_LIMIT": "0",
    "QLOO_OPERATOR_STOP": "true",
    "QLOO_GRANT_STOP": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QLOO_BUDGET",
        "class_name": "QlooBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "QlooBudget"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
